APP_NAME="For You"
APP_ENV=local
APP_KEY=
# في الإنتاج لازم يكون false — true بيكشف التفاصيل الحساسة في الأخطاء.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=for_you
DB_USERNAME=root
DB_PASSWORD=
# توقيت اتصال MySQL (اتركه فاضي لاستخدام توقيت السيرفر)
# DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# مدة صلاحية توكن Sanctum بالدقائق (10080 = 7 أيام، 0 = بلا انتهاء)
SANCTUM_EXPIRATION=10080

# خلف Cloudflare / Load Balancer: قائمة IPs/نطاقات البروكسي الموثوقة
# (فاضية = مفيش بروكسي موثوق). لو عندك بروكسي ديناميكي استخدم *
TRUSTED_PROXIES=

# Socialite - Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/api/auth/apple/callback"
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional: Google / Facebook if you add them later
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
# GOOGLE_CLIENT_IDS=
# WITHDRAWAL_FOUR_EYES=true

VITE_APP_NAME="${APP_NAME}"
# Frontend (روابط reset الباسورد + الروابط الترويجية)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# انتهاء الطلبات غير المدفوعة بالساعات (0 = تعطيل)
UNPAID_ORDER_TTL_HOURS=24
# طرق الدفع المؤهلة للإلغاء التلقائي (الدفع اليدوي/COD مستثنى)
EXPIRE_UNPAID_PAYMENT_METHODS=easykash

# شحن
SHIPPING_FLAT_RATE=50
# SHIPPING_FREE_OVER=500
SHIPPING_GATEWAY=manual
SHIPPING_WEBHOOK_SECRET=
SHIPPING_SIGNATURE_HEADER=X-Shipping-Signature

# الدفع
PAYMENT_GATEWAY=manual
DEFAULT_PAYMENT_METHOD=manual
PAYMENT_METHODS=manual,easykash

# EasyKash (skeleton — املأ القيم لتفعيل البوابة)
EASYKASH_WEBHOOK_SECRET=
EASYKASH_SIGNATURE_HEADER=X-EasyKash-Signature
EASYKASH_MERCHANT_ID=
EASYKASH_INITIATE_URL=
EASYKASH_MODE=sandbox
# سر توقيع رابط الدفع (يرجع لـ EASYKASH_WEBHOOK_SECRET لو فاضي)
EASYKASH_INITIATE_SECRET=
# نافذة قبول timestamp الـ webhook بالثواني لمنع replay (0 = معطّلة)
EASYKASH_WEBHOOK_TOLERANCE=0

# التحقق من الإيميل للعملاء (skeleton)
EMAIL_VERIFICATION_ENABLED=false

# نفس الزائر لا يُحسب click جديد لنفس الرابط قبل مرور هذه الدقائق
LINK_CLICK_TTL_MINUTES=60

# عمولات المؤثرين
INFLUENCER_DEFAULT_COMMISSION=10
INFLUENCER_COMMISSION_HOLD_DAYS=7

# مبدأ الشخصين في السحب
WITHDRAWAL_FOUR_EYES=true
REQUIRE_PAYMENT_BEFORE_SHIPPING=true

# Super Admin (مطلوب في production — اتركه فاضي في local لو عايز القيم الافتراضية)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Super Admin"
ADMIN_PHONE=01000000000
